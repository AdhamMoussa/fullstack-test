{
  "name": "@repo/api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "nest build",
    "dev": "nodemon",
    "start": "nest start",
    "start:dev": "nodemon",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts"
  },
  "nodemonConfig": {
    "watch": [
      "src",
      "../../packages/db/dist",
      "../../packages/db/generated/prisma/index.js",
      "../../packages/contract/dist"
    ],
    "ext": "ts,js,json",
    "ignore": [
      "../../packages/db/dist/*.d.ts",
      "../../packages/db/dist/*.map",
      "../../packages/contract/dist/*.d.ts",
      "../../packages/contract/dist/*.map"
    ],
    "delay": 1000,
    "signal": "SIGTERM",
    "exec": "nest start"
  },
  "dependencies": {
    "@repo/contract": "workspace:*",
    "@repo/db": "workspace:*",
    "@nestjs/authentication": "^0.1.5",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.1.1",
    "@nestjs/mail": "^0.0.2",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-express": "^12.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@swc/cli": "^0.8.2",
    "@swc/core": "^1.16.22",
    "@types/express": "^5.0.0",
    "@types/node": "catalog:",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.0.0",
    "typescript": "catalog:",
    "vite": "^8.0.0",
    "vitest": "^4.1.2"
  }
}
