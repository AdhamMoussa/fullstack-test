# Host-run API only. Docker Compose injects the same variables with MONGODB_URI=mongo:27017.
PORT=3000
MONGODB_URI="mongodb://127.0.0.1:27017/assessment?replicaSet=rs0&directConnection=true"
WEB_ORIGIN="http://localhost:5173"
APP_URL="http://localhost:5173"
MAIL_FROM="Auth Assessment <no-reply@localhost>"
SESSION_ABSOLUTE_TTL="7d"
SESSION_IDLE_TTL="1d"
# Optional: smtp://user:pass@host:587 or smtps://user:pass@host:465
# SMTP_URL=""
