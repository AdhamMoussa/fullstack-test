# Production image for @repo/web: static files served by unprivileged nginx.
FROM node:26.13.0-bookworm-slim AS build

RUN npm install -g pnpm@11.0.5

WORKDIR /app

# Download dependencies from the lockfile alone, so this layer survives source edits.
COPY pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm fetch

COPY . .
# CI=true: non-interactive; lets pnpm relink the store `pnpm fetch` created.
RUN CI=true pnpm install --offline --frozen-lockfile

# The API origin is baked into the bundle; `vite.config.ts` fails without it.
ARG VITE_API_URL
ENV VITE_API_URL=$VITE_API_URL
RUN pnpm exec turbo run build --filter=@repo/web

FROM nginxinc/nginx-unprivileged:1.30-alpine

# Runs as uid 101 and listens on 8080; the image already redirects its temp paths
# to /tmp. The server block replaces the image's default site.
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/apps/web/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1:8080/ >/dev/null || exit 1

CMD ["nginx", "-g", "daemon off;"]
