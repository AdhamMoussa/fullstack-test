{
  "name": "@repo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "watch": "tsup --watch",
    "dev": "prisma generate && prisma db push --skip-generate && pnpm push:test && tsup --watch --onSuccess 'touch /tmp/db-ready'",
    "push:test": "MONGODB_URI=${MONGODB_TEST_URI:?MONGODB_TEST_URI is required} prisma db push --skip-generate",
    "generate": "prisma generate",
    "push": "prisma db push",
    "studio": "prisma studio --hostname 0.0.0.0 --browser none",
    "lint": "biome check",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "6.19.0"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "prisma": "6.19.0",
    "tsup": "catalog:",
    "typescript": "catalog:"
  }
}
